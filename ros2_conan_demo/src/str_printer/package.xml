<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>str_printer</name>
  <version>0.1.0</version>
  <description>Small ament_cmake library that formats strings with fmt, where fmt is provided by Conan.</description>
  <maintainer email="ben.sung@hyarks.com">Ben Sung</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- fmt intentionally is NOT declared here: it comes from Conan, not from rosdep. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
